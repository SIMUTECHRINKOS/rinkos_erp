# ─── RINKOS ERP — Variables de entorno ───────────────────────────────────────
# Copiar este archivo como .env y completar los valores reales.
# NUNCA commitear el archivo .env con valores reales.

# Base de datos (local desarrollo)
DATABASE_URL=postgresql://macmini@localhost:5432/rinkos_erp_dev

# Base de datos (producción Render — completar en dashboard de Render)
# DATABASE_URL=postgresql://user:password@host/dbname

# Aplicación
APP_ENV=development          # development | production
SECRET_KEY=cambia-este-valor-por-uno-seguro-en-produccion
API_V1_PREFIX=/api/v1

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
